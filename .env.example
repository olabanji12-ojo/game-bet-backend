# =================================================================
# FANCLUB68.COM - CENTRALIZED CORE CONFIGURATION SPECIFICATION
# =================================================================
PORT=3000
NODE_ENV=development

# 1. DATA PROVIDER AUTHORIZATION STRING & PARAMS
THE_ODDS_API_KEY=YOUR_THE_ODDS_API_KEY
SPORTS_MARKETS_PARAMS=spreads,totals,outlays,player_props,tennis_props

# 2. INACTIVITY & CACHING TIMEOUTS
LAZY_LOADING_IDLE_TIMEOUT_SECONDS=60
ACTIVE_WINDOW_CHECK_INTERVAL_MINUTES=10
CACHE_TTL_LIVE_SECONDS=15

# 3. ANTI-LATENCY ASYNCHRONOUS DELAY TIERS (SECONDS)
DELAY_TIER_1_STANDARD_SECONDS=8
DELAY_TIER_2_DANGEROUS_ATTACK_SECONDS=15
DELAY_TIER_3_CRITICAL_EVENT_SECONDS=25

# 4. COCKFIGHT ANTI-VÉT BUFFER LOCK (SECONDS)
DELAY_COCKFIGHT_BOOKING_LOCK_SECONDS=3

# 5. RISK MANAGEMENT & STAKE CEILINGS
MAX_BET_LIMIT_POINTS=300
ODDS_DRIFT_THRESHOLD=0.05

# 6. CASINO TIMERS (SECONDS)
CASINO_CYCLE_DURATION_SECONDS=40
CASINO_INVISIBLE_BUFFER_SECONDS=5

# 7. TELEGRAM BOT
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID
